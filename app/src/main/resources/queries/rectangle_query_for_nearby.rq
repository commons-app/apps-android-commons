PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>

SELECT
  ?item
  (SAMPLE(?locationValue) AS ?location)
WHERE {
  # One geof:sfWithin keeps QLever's spatial index. A box across ±180° is a multipolygon.
  BIND(${LONG_WEST} AS ?west)
  BIND(${LONG_EAST} AS ?east)
  BIND(IF(${LAT_WEST} < ${LAT_EAST}, ${LAT_WEST}, ${LAT_EAST}) AS ?south)
  BIND(IF(${LAT_WEST} < ${LAT_EAST}, ${LAT_EAST}, ${LAT_WEST}) AS ?north)
  BIND(IF(?west <= ?east,
    CONCAT("POLYGON((", STR(?west), " ", STR(?south), ", ", STR(?east), " ", STR(?south), ", ", STR(?east), " ", STR(?north), ", ", STR(?west), " ", STR(?north), ", ", STR(?west), " ", STR(?south), "))"),
    CONCAT("MULTIPOLYGON(((", STR(?west), " ", STR(?south), ", 180 ", STR(?south), ", 180 ", STR(?north), ", ", STR(?west), " ", STR(?north), ", ", STR(?west), " ", STR(?south), ")), ((-180 ", STR(?south), ", ", STR(?east), " ", STR(?south), ", ", STR(?east), " ", STR(?north), ", -180 ", STR(?north), ", -180 ", STR(?south), ")))")
  ) AS ?boxWkt)
  BIND(STRDT(?boxWkt, geo:wktLiteral) AS ?box)
  ?item wdt:P625 ?locationValue .
  FILTER(geof:sfWithin(?locationValue, ?box))
}
GROUP BY ?item
