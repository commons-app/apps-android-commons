    {
      "id": "claim_6907d29d701745f2b5c6ea0494fcf360",
      "statement": "The shared Retrofit transport is built from a singleton OkHttp client with 120-second connect, write, and read timeouts, a 64 MiB application cache when an application context exists, BASIC logging with Authorization and Cookie redaction, a common User-Agent header, and response interception that maps unsuccessful HTTP responses and MediaWiki JSON errors to IOExceptions or MwIOException; the upload API URL is excluded from JSON-error interception.",
      "evidence": [
